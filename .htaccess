<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # 1. API Routing
  # Route /api/products/:slug or /api/products/categories
  RewriteRule ^api/products/(.+)$ api/products/index.php?slug=$1 [L,QSA]
  # Route /api/products
  RewriteRule ^api/products/?$ api/products/index.php [L,QSA]
  # Route /api/storefront
  RewriteRule ^api/storefront/?$ api/storefront/index.php [L,QSA]
  # Route /api/health
  RewriteRule ^api/health/?$ api/health/index.php [L,QSA]
  # Route /api/bookings
  RewriteRule ^api/bookings/?$ api/bookings/index.php [L,QSA]
  # Route /api/chat/message
  RewriteRule ^api/chat/message/?$ api/chat/message/index.php [L,QSA]

  # 2. Asset Routing
  # Redirect /assets to /frontend/build/assets
  RewriteRule ^assets/(.*)$ frontend/build/assets/$1 [L]
  
  # Redirect /static to /frontend/build/static
  RewriteRule ^static/(.*)$ frontend/build/static/$1 [L]

  # 3. Static Files
  # If a file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Routing
  # Fallback to index.php for React routing
  RewriteRule ^ index.php [L]
</IfModule>
