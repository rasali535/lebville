<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Routing
  RewriteRule ^api/products/(.+)$ api/products/index.php?slug=$1 [L,QSA]
  RewriteRule ^api/products/?$ api/products/index.php [L,QSA]
  RewriteRule ^api/storefront/?$ api/storefront/index.php [L,QSA]
  RewriteRule ^api/health/?$ api/health/index.php [L,QSA]
  RewriteRule ^api/bookings/?$ api/bookings/index.php [L,QSA]
  RewriteRule ^api/chat/message/?$ api/chat/message/index.php [L,QSA]

  # 2. Asset & Static Routing
  RewriteRule ^assets/(.*)$ frontend/build/assets/$1 [L]
  RewriteRule ^static/(.*)$ frontend/build/static/$1 [L]

  # 3. Existing Static Files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback
  RewriteRule ^ index.php [L]
</IfModule>
